     switch (l.proj) {
         .bf16 => |p| try b16.matmul(selected, stream, x, x_stride, p, s.p, s.mm_part, rows, w, l.dims, false),
@@ -117,16 +137,20 @@ fn columns(set: glue.Set, stream: cuda.Stream, src: u64, cols: usize, dst: u64,
 pub fn chainRows(ks: *const kda.Kernels, stream: cuda.Stream, l: Layer, s: Scratch, rows: usize, conv_state: u64, state_in: u64, wide: bool) !void {
     const n = l.heads * kda.dk;
     const fa = 3 * n;
-    const c: kda.Chain = .{ .p = s.p, .p_stride = l.width(), .b_off = fa + 2 * kda.dk, .a = s.ka, .a_stride = n, .g = s.kg, .g_stride = n, .conv_state = conv_state, .conv_w = l.conv_w, .state_in = state_in, .a_log = l.a_log, .dt_bias = l.dt_bias, .norm_w = l.norm_w, .eps = l.eps, .lower = l.lower, .heads = l.heads };
+    const c: kda.Chain = .{ .p = s.p, .p_stride = l.matWidth(), .b_off = fa + 2 * kda.dk, .a = s.ka, .a_stride = n, .g = s.kg, .g_stride = n, .conv_state = conv_state, .conv_w = l.conv_w, .state_in = state_in, .a_log = l.a_log, .dt_bias = l.dt_bias, .norm_w = l.norm_w, .eps = l.eps, .lower = l.lower, .heads = l.heads };
     try kda.chain(ks, stream, c, rows, s.saves, if (wide or rows >= kda.wide_rows) s.wide else null);
 }
 
 /// A shared window's chains (decode, three-kernel): every segment of `t` in one launch each (kda.chainSegs), the
 /// layer's own fields as chainRows passes them; each segment's rows, states and saves come with it.
 pub fn chainSegs(ks: *const kda.Kernels, stream: cuda.Stream, l: Layer, t: *const kda.Segs, n: usize) !void {
+    try kda.chainSegs(ks, stream, segChain(l), t, n);
+}
+
+/// chainSegs' layer fields; its rows sit in the state at the padded width (TF_GLM_KDA_PAD), as cuda_shared copies them.
+pub fn segChain(l: Layer) kda.Chain {
     const fa = 3 * l.heads * kda.dk;
-    const c: kda.Chain = .{ .p = 0, .p_stride = l.width(), .b_off = fa + 2 * kda.dk, .a = 0, .a_stride = l.heads * kda.dk, .g = 0, .g_stride = l.heads * kda.dk, .conv_state = 0, .conv_w = l.conv_w, .state_in = 0, .a_log = l.a_log, .dt_bias = l.dt_bias, .norm_w = l.norm_w, .eps = l.eps, .lower = l.lower, .heads = l.heads };
-    try kda.chainSegs(ks, stream, c, t, n);
+    return .{ .p = 0, .p_stride = l.matWidth(), .b_off = fa + 2 * kda.dk, .a = 0, .a_stride = l.heads * kda.dk, .g = 0, .g_stride = l.heads * kda.dk, .conv_state = 0, .conv_w = l.conv_w, .state_in = 0, .a_log = l.a_log, .dt_bias = l.dt_bias, .norm_w = l.norm_w, .eps = l.eps, .lower = l.lower, .heads = l.heads };
