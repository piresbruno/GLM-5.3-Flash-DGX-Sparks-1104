@@ -76,7 +96,7 @@ pub fn project(set: glue.Set, stream: cuda.Stream, l: Layer, s: Scratch, x: u64,
     var selected = set;
     if (!l.tiledInput()) selected.mm = null;
     const n = l.heads * kda.dk;
-    const w = l.width();
+    const w = l.matWidth();
