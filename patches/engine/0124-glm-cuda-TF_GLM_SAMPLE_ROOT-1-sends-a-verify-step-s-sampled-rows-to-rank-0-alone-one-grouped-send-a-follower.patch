+    /// `gather`, the rows whole on every rank (.all) or on rank 0 alone (.root; `full` then holds nothing on a follower).
+    pub fn gatherTo(s: *const Sampler, stream: cuda.Stream, exchange: Exchange, spans: []const Span, mine: []const Local, rows: usize, full: u64, to: To) !void {
