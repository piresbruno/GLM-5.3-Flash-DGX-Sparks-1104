+    fn copy2d(s: *const Sampler, stream: cuda.Stream, dst: u64, dst_pitch: usize, src: u64, src_pitch: usize, width: usize, height: usize) !void {
+        const c: cuda.abi.Memcpy2D = .{ .src = src, .src_pitch = src_pitch, .dst = dst, .dst_pitch = dst_pitch, .width = width, .height = height };
