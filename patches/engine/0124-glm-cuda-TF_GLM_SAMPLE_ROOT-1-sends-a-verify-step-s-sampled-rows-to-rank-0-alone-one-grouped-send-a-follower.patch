+
+/// To.root's group: each follower sends its [rows][span] block to rank 0 in one send; rank 0 receives every
+/// follower's block into the stage, packed in rank order (`at`). Two NCCL operations a follower, world - 1 on rank 0,
+/// instead of a broadcast a row a rank on every rank.
+const Root = struct {
+    lib: *const cuda.nccl.Library,
+    comm: cuda.nccl.Comm,
+    stream: cuda.Stream,
+    stage: u64,
+    spans: []const Span,
+    rows: usize,
+    rank: usize,
+    logits: u64,
+
+    /// Rank q's block's byte offset in the stage: the blocks of ranks 1 .. q - 1 before it.
+    fn at(spans: []const Span, rows: usize, q: usize) usize {
+        var off: usize = 0;
+        for (spans[1..q]) |sp| off += rows * sp.len() * 2;
+        return off;
+    }
+
+    fn post(t: Root) anyerror!void {
+        if (t.rank != 0) {
+            const n = t.rows * t.spans[t.rank].len();
+            return t.lib.check(t.lib.api.ncclSend(t.logits, n, .bf16, 0, t.comm, t.stream.handle), "ncclSend");
+        }
+        for (t.spans[1..], 1..) |span, q| {
+            const dst = t.stage + at(t.spans, t.rows, q);
+            try t.lib.check(t.lib.api.ncclRecv(dst, t.rows * span.len(), .bf16, @intCast(q), t.comm, t.stream.handle), "ncclRecv");
+        }
+    }
+};
+
+test "TF_GLM_SAMPLE_ROOT's group at TP=3: each follower one send of its block, rank 0 one receive a follower, packed" {
+    const Fake = struct {
+        const Op = struct { send: bool, buf: u64, count: usize, peer: c_int };
+        var ops: [8]Op = undefined;
+        var n: usize = 0;
+        fn send(buf: cuda.abi.DevicePtr, count: usize, _: cuda.nccl.DataType, peer: c_int, _: cuda.nccl.Comm, _: cuda.abi.Stream) callconv(.c) cuda.nccl.Result {
+            ops[n] = .{ .send = true, .buf = buf, .count = count, .peer = peer };
+            n += 1;
+            return 0;
+        }
+        fn recv(buf: cuda.abi.DevicePtr, count: usize, _: cuda.nccl.DataType, peer: c_int, _: cuda.nccl.Comm, _: cuda.abi.Stream) callconv(.c) cuda.nccl.Result {
+            ops[n] = .{ .send = false, .buf = buf, .count = count, .peer = peer };
+            n += 1;
+            return 0;
+        }
+    };
+    var lib: cuda.nccl.Library = undefined;
+    lib.api.ncclSend = Fake.send;
+    lib.api.ncclRecv = Fake.recv;
+    const spans = [_]Span{ .{ .lo = 0, .hi = 5 }, .{ .lo = 5, .hi = 8 }, .{ .lo = 8, .hi = 10 } }; // uneven, as at TP=3
+    const stream: cuda.Stream = .{ .d = undefined, .handle = null };
+    var t: Root = .{ .lib = &lib, .comm = null, .stream = stream, .stage = 0x1000, .spans = &spans, .rows = 4, .rank = 0, .logits = 0x9000 };
+    try t.post();
+    try std.testing.expectEqual(@as(usize, 2), Fake.n);
+    try std.testing.expectEqual(Fake.Op{ .send = false, .buf = 0x1000, .count = 4 * 3, .peer = 1 }, Fake.ops[0]);
+    try std.testing.expectEqual(Fake.Op{ .send = false, .buf = 0x1000 + 4 * 3 * 2, .count = 4 * 2, .peer = 2 }, Fake.ops[1]);
+    for ([_]usize{ 1, 2 }) |rank| {
+        Fake.n = 0;
+        t.rank = rank;
+        try t.post();
+        try std.testing.expectEqual(@as(usize, 1), Fake.n);
+        try std.testing.expectEqual(Fake.Op{ .send = true, .buf = 0x9000, .count = 4 * spans[rank].len(), .peer = 0 }, Fake.ops[0]);
+    }
+    try std.testing.expectEqual(@as(usize, 0), Root.at(&spans, 4, 1));
+    try std.testing.expectEqual(@as(usize, 24), Root.at(&spans, 4, 2));
+}
